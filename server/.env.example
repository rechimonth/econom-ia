NODE_ENV=development
PORT=8787
APP_TIMEZONE=America/Argentina/Buenos_Aires
TRUST_PROXY=false

# Comma-separated browser origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:3000,http://tauri.localhost
PUBLIC_APP_URL=http://localhost:3000

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=YOUR_VERIFIED_OPENAI_MODEL

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_PRO_PRICE_ID=price_YOUR_MONTHLY_PRO_PRICE_ID
STRIPE_PRO_PRODUCT_NAME=Econom-IA Pro
STRIPE_PRO_PRODUCT_DESCRIPTION=Copiloto financiero con acceso ampliado a IA
BILLING_CURRENCY=usd
BILLING_INTERVAL=month
BILLING_CANCEL_AT_PERIOD_END=true
